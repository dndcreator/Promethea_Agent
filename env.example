# =============================================================
# Promethea env template (practical)
# Copy to .env and edit in one place.
# Keep secrets here; related runtime fields are grouped nearby.
# =============================================================

# -------------------------------------------------------------
# Runtime logging
# -------------------------------------------------------------
SYSTEM__LOG_LEVEL=INFO
# Sensitive: includes prompts, conversations, and recalled memory in dependency debug logs.
SYSTEM__LOG_MODEL_PAYLOADS=false

# Temporary text-only guest chat uses the operator's main model configuration.
# Enabled for direct loopback access; public/reverse-proxy access is opt-in.
GUEST_CHAT__ENABLED=true
GUEST_CHAT__ALLOW_REMOTE=false
GUEST_CHAT__REQUESTS_PER_MINUTE=6
GUEST_CHAT__MAX_CONCURRENT=2
GUEST_CHAT__MAX_OUTPUT_TOKENS=1024

# -------------------------------------------------------------
# API (main model): usually configured together
# -------------------------------------------------------------
API__API_KEY=replace_with_your_api_key
API__BASE_URL=https://your-provider.example/v1
API__MODEL=your_model_name
# Optional: comma-separated backup models
API__FAILOVER_MODELS=

# Cost estimates only, not a billing authority. Never infer tariffs from model names.
# Auto-refresh currently supports the official OpenRouter model catalog only.
PRICING__AUTO_REFRESH=true
PRICING__CACHE_TTL_S=3600
PRICING__REQUEST_TIMEOUT_S=2
# Optional JSON list of exact endpoint/model USD rates; see docs/configuration.md.
# Empty means unknown for providers without a supported price source, not free.
PRICING__RATES=[]

# Optional dedicated multimodal model. Promethea tries the main model first.
# If the provider reports that the requested modality is unsupported, this
# endpoint is used. Empty key/base URL values inherit the main API settings.
MULTIMODAL__MODEL=
MULTIMODAL__BASE_URL=
MULTIMODAL__API_KEY=

# -------------------------------------------------------------
# Web search provider for the official web.search tool
# -------------------------------------------------------------
# Options: auto | brave | tavily | serpapi | searxng | duckduckgo
# auto uses the first configured provider below, then falls back to DuckDuckGo.
SEARCH__PROVIDER=auto
# strict uses only the selected/highest-priority available provider; fallback tries the ordered candidates.
SEARCH__FALLBACK_POLICY=fallback
# Optional comma-separated preference order. Unlisted providers follow their declared priority.
SEARCH__PROVIDER_ORDER=brave,tavily,serpapi,searxng,duckduckgo
# Optional API-backed providers
SEARCH__BRAVE_API_KEY=
SEARCH__TAVILY_API_KEY=
SEARCH__SERPAPI_API_KEY=
# Optional self-hosted/key-free provider. Example: http://127.0.0.1:8888
SEARCH__SEARXNG_URL=

# -------------------------------------------------------------
# Personal mail/calendar accounts are configured in Settings or explicitly in
# config/users/<user_id>/secrets.env, NOT inherited from this root .env.
# See docs/playbooks/personal-assistant.md for keys and the optional CalDAV extra.
# Auth / gateway
# -------------------------------------------------------------
# Use a long random value in real deployments.
AUTH__SECRET_KEY=replace_with_a_long_random_secret
# Cookie name used by browser auth.
AUTH__COOKIE_NAME=promethea_auth
# Set true only behind HTTPS.
AUTH__COOKIE_SECURE=false
# If set, gateway clients must provide this token when connecting.
GATEWAY_AUTH_TOKEN=

# -------------------------------------------------------------
# Voice (optional / experimental): key + provider/model settings
# -------------------------------------------------------------
# DeepSeek-only chat configs do not provide STT/audio transcription.
# Configure a real OpenAI-compatible audio provider before using voice routes.
# openai | elevenlabs
VOICE__PROVIDER=openai
VOICE__STT_PROVIDER=openai
VOICE__STT_MODEL=gpt-4o-mini-transcribe
VOICE__MODEL=gpt-4o-mini-tts
VOICE__VOICE=alloy
VOICE__FORMAT=mp3
VOICE__SPEED=1.0
# Keep empty to reuse API__BASE_URL for OpenAI-compatible voice routes.
# If API__BASE_URL points at a chat-only provider, set a separate voice base URL.
VOICE__BASE_URL=
# Keep empty to reuse API__API_KEY
VOICE__API_KEY=
# Needed only when provider=elevenlabs
VOICE__ELEVENLABS_API_KEY=

# -------------------------------------------------------------
# Memory (default backend is neo4j): endpoint settings + secret
# -------------------------------------------------------------
# Backend options:
# - neo4j: default/core graph backend; registration requires Neo4j to be reachable.
# - sqlite_graph: local graph-capable fallback.
# - flat_memory: lightweight JSONL fallback.
# After changing MEMORY__STORE_BACKEND, restart the gateway.
MEMORY__ENABLED=true
MEMORY__STORE_BACKEND=neo4j
MEMORY__SQLITE_GRAPH_PATH=memory/sqlite_graph.db
MEMORY__FLAT_MEMORY_PATH=memory/flat_memory.jsonl
MEMORY__NEO4J__ENABLED=true
MEMORY__NEO4J__URI=bolt://127.0.0.1:7687
MEMORY__NEO4J__USERNAME=neo4j
MEMORY__NEO4J__PASSWORD=
MEMORY__NEO4J__DATABASE=neo4j

# Optional separate model for memory extraction
MEMORY__API__USE_MAIN_API=true
MEMORY__API__API_KEY=
MEMORY__API__BASE_URL=https://openrouter.ai/api/v1
MEMORY__API__MODEL=

# Idle replay can reuse grounded cognition as untrusted hints. Hints are never memory evidence.
MEMORY__HIPPOCAMPUS__COGNITION_HINT_THRESHOLD=4
MEMORY__HIPPOCAMPUS__MAX_PENDING_COGNITION_HINTS=24
MEMORY__HIPPOCAMPUS__MAX_COGNITION_HINT_CHARS=2000

# Query-conditioned cognition recall. Fast mode adds no model call.
SELF_MODEL__RECALL__ENABLED=true
SELF_MODEL__RECALL__CANDIDATE_POOL_LIMIT=60
SELF_MODEL__RECALL__FAST_CANDIDATE_LIMIT=12
SELF_MODEL__RECALL__MAX_CHANNELS=3
SELF_MODEL__RECALL__MAX_DEPTH=2
SELF_MODEL__RECALL__MAX_PARALLEL_CALLS=4
SELF_MODEL__RECALL__MAX_KERNEL_CALLS=8
SELF_MODEL__RECALL__DEADLINE_MS=6000
# Deterministic, expiring environment projection; no extra model request.
SELF_MODEL__ENVIRONMENT_TTL_S=60
SELF_MODEL__OBSERVATION_CHARS=3200

# -------------------------------------------------------------
# Host capability sandbox (enabled and fail-closed by default)
# -------------------------------------------------------------
SANDBOX__ENABLED=true
SANDBOX__PROFILE=strict
SANDBOX__WORKSPACE_ACCESS=rw
SANDBOX__COMMAND_MODE=approval
SANDBOX__DESKTOP_MODE=approval
SANDBOX__PROCESS_MODE=managed_only
SANDBOX__BROWSER_DISABLE_CHROMIUM_SANDBOX=false
SANDBOX__COMPUTER_MAX_WORKSPACES=8
# Operator-only exceptions for configured service endpoints, not arbitrary web URLs.
SANDBOX__ALLOWED_SERVICE_URLS=[]
# Only inside a disposable VM, Windows Sandbox, or dedicated low-privilege host:
# SANDBOX__COMMAND_MODE=allowlist
# SANDBOX__DESKTOP_MODE=host_control
# SANDBOX__PROCESS_MODE=host_control

# -------------------------------------------------------------
# Optional HTTP/runtime controls
# -------------------------------------------------------------
# Comma-separated CORS origins for browser clients.
API__CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

# Goal-relative state shares the main Action model call; no separate reviewer.
ACTION__MAX_PARALLEL_TOOL_CALLS=4
ACTION__OBSERVATION_CHARS=16000
ACTION__OBSERVATION_HISTORY_CHARS=96000
ACTION__GAPS__ENABLED=true
ACTION__GAPS__MAX_GAPS=12
ACTION__GAPS__MAX_UPDATES=6
ACTION__GAPS__WINDOW=4
ACTION__GAPS__CONTEXT_CHARS=2400

# Moirai process experience (see agentkit/tools/moirai/README.md).
MOIRAI_LEARNING__ENABLED=true
MOIRAI_LEARNING__DISTILLATION_ENABLED=true
MOIRAI_LEARNING__MIN_EPISODES=8
MOIRAI_LEARNING__INTERVAL_SECONDS=3600
MOIRAI_LEARNING__IDLE_SECONDS=60
MOIRAI_LEARNING__TIMEOUT_SECONDS=30

# Shared browser preparation: matching Chromium, installed Edge/Chrome, then
# managed Chromium download if no browser is usable. Explicit channels are strict.
SYSTEM__BROWSER_CHANNEL=
SYSTEM__BROWSER_AUTO_INSTALL=true
SYSTEM__BROWSER_INSTALL_TIMEOUT_S=120
SYSTEM__BROWSER_INSTALL_RETRY_DELAY_S=60
# Optional per-user Canvas override; empty follows shared automatic preparation.
SELF_EVOLVE__BROWSER_CHANNEL=

# Kernel scheduler controls local recurring automation wakeups.
KERNEL_SCHEDULER__ENABLED=true
KERNEL_SCHEDULER__TICK_SECONDS=5.0
KERNEL_SCHEDULER__MAX_JOBS_PER_TICK=10
KERNEL_SCHEDULER__START_PAUSED=false

# Optional bounded delegation; the chat switch remains off until selected.
MULTI_AGENT__ENABLED=true
MULTI_AGENT__MAX_CHILDREN=6
MULTI_AGENT__MAX_PARALLEL=3
MULTI_AGENT__MAX_PENDING=24
MULTI_AGENT__MAX_DEPTH=1
MULTI_AGENT__CHILD_STEPS=5
MULTI_AGENT__CHILD_MAX_TOKENS=2048
MULTI_AGENT__TIMEOUT_S=120
MULTI_AGENT__RESULT_CHARS=12000

# Ambient module availability; each conversation still requires explicit opt-in.
AMBIENT__ENABLED=true
AMBIENT__INTERVAL_S=3600
AMBIENT__COOLDOWN_S=30
AMBIENT__DAILY_CYCLES=24
AMBIENT__MAX_PARALLEL=1
AMBIENT__MAX_STEPS=5
AMBIENT__MAX_TOKENS=2048
AMBIENT__TIMEOUT_S=120
AMBIENT__COMMUNICATION_COOLDOWN_S=30

# Operator-owned messaging plugins; see docs/channels/README.md. Restart after changes.
CHANNELS__QQ__ENABLED=false
CHANNELS__QQ__APP_ID=
CHANNELS__QQ__CLIENT_SECRET=
CHANNELS__QQ__BOT_SECRET=
CHANNELS__QQ__GROUPS={}
CHANNELS__TELEGRAM__ENABLED=false
CHANNELS__TELEGRAM__BOT_TOKEN=
CHANNELS__TELEGRAM__WEBHOOK_SECRET=
CHANNELS__FEISHU__ENABLED=false
CHANNELS__FEISHU__APP_ID=
CHANNELS__FEISHU__APP_SECRET=
CHANNELS__FEISHU__VERIFICATION_TOKEN=
CHANNELS__FEISHU__ENCRYPT_KEY=
CHANNELS__FEISHU__GROUPS={}
CHANNELS__DINGTALK__ENABLED=false
CHANNELS__DINGTALK__APP_KEY=
CHANNELS__DINGTALK__APP_SECRET=
CHANNELS__DINGTALK__ROBOT_CODE=
CHANNELS__DINGTALK__CORP_ID=
CHANNELS__DINGTALK__GROUPS={}
CHANNELS__WECOM__ENABLED=false
CHANNELS__WECOM__CORP_ID=
CHANNELS__WECOM__AGENT_ID=0
CHANNELS__WECOM__APP_SECRET=
CHANNELS__WECOM__CALLBACK_TOKEN=
CHANNELS__WECOM__ENCODING_AES_KEY=
CHANNELS__QUEUE_LIMIT=200
CHANNELS__TURN_TIMEOUT_S=240
CHANNELS__RETENTION_DAYS=30

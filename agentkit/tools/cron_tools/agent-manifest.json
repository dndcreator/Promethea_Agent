{
  "name": "cron_tools",
  "label": "Cron Tools",
  "version": "2.0.0",
  "description": "User-scoped temporal scheduling for registered capabilities.",
  "serviceType": "internal_tool",
  "entryPoint": {
    "module": "gateway.temporal_scheduler",
    "class": "TemporalSchedulerService"
  },
  "capabilities": {
    "invocation_commands": [
      {
        "command": "create_job",
        "sideEffectLevel": "workspace_write",
        "description": "Schedule any registered capability with an interval, instant, or calendar trigger.",
        "example": "create_job(name='sync', trigger={'type':'calendar','time':'09:00','weekdays':[0,1,2,3,4]}, service_name='runtime_tools', tool_name='gateway_action', args={'action':'status'})"
      },
      {
        "command": "list_jobs",
        "sideEffectLevel": "read_only",
        "description": "List persisted jobs.",
        "example": "list_jobs(enabled_only=true)"
      },
      {
        "command": "remove_job",
        "sideEffectLevel": "workspace_write",
        "description": "Remove a job by id.",
        "example": "remove_job(job_id='job_xxx')"
      },
      {
        "command": "pause_job",
        "sideEffectLevel": "workspace_write",
        "description": "Pause a job.",
        "example": "pause_job(job_id='job_xxx')"
      },
      {
        "command": "resume_job",
        "sideEffectLevel": "workspace_write",
        "description": "Resume a job.",
        "example": "resume_job(job_id='job_xxx')"
      }
    ]
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "name": { "type": "string" },
      "interval_seconds": { "type": "integer" },
      "trigger": { "type": "object" },
      "timezone_name": { "type": "string" },
      "misfire_policy": { "type": "string", "enum": ["run_once", "skip"] },
      "misfire_grace_seconds": { "type": "integer" },
      "service_name": { "type": "string" },
      "tool_name": { "type": "string" },
      "args": { "type": "object" },
      "enabled": { "type": "boolean" },
      "enabled_only": { "type": "boolean" },
      "job_id": { "type": "string" }
    }
  }
}
